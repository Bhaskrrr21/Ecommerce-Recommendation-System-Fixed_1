# --- Data ---
# Raw Retailrocket CSVs are intentionally excluded. They can be downloaded
# from Kaggle or regenerated with: python -m src.generate_sample_data
# Processed Parquet files and trained .joblib models are intentionally kept
# because the deployed Streamlit app needs them at runtime.
data/raw/*.csv
!data/raw/.gitkeep

